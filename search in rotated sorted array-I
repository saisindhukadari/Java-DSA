# linear search
class Solution {
    public int search(int[] nums, int target) {
        int n = nums.length;
        int i=0;
        while(i<n){
            if(nums[i]==target){
                return i;
            }
            i++;
        }
        return -1;
    }
}


# binary search
class Solution {
    public int search(int[] nums, int target) {
        int N = nums.length;
        int low=0;
        int high=N-1;
        while(low<=high){
            int mid=low+(high-low)/2;
            if(nums[mid]==target){
                return mid;
            }
            if(nums[low]<=nums[mid]){
                if(nums[low]<=target&&target<nums[mid]){
                    high=mid-1;
                }else{
                    low=mid+1;
                }
            }else{
                if(nums[mid]<target&&target<=nums[high]){
                    low=mid+1;
                }else{
                    high=mid-1;
                }
            }
        }
        return -1;
    }
}
